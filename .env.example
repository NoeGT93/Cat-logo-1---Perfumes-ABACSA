# Local: copiar como .dev.vars (no se sube al repositorio).
NEXTJS_ENV=development
ADMIN_PASSWORD=una-clave-solo-para-pruebas-locales
# Opcional: dominio público para los enlaces de WhatsApp (si falta, se usa el del navegador)
# NEXT_PUBLIC_SITE_URL=https://catalogo.abacsa.com
